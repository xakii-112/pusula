# Copy to .env (never committed) and point PUSULA_ENV_FILE at it.
# The test suite needs none of these. SEC, FINRA, DoltHub and Binance downloads need no key.

# Alpaca paper account: daily bars and paper orders
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Identify yourself to SEC EDGAR, as its fair-access policy asks: "Name email@example.com"
PUSULA_SEC_USER_AGENT=

# Optional: nightly alerts and an external heartbeat
PUSULA_TELEGRAM_TOKEN=
PUSULA_TELEGRAM_CHAT_ID=
PUSULA_HEARTBEAT_URL=

# Optional: where data and forward books live (default ~/.pusula)
# PUSULA_HOME=
